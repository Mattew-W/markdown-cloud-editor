+/** 可控时钟：`tick` 推进并触发到期回调；`clearTimeout` 真的移除定时器。 */
+function makeClock() {
+  let now = 0;
+  let seq = 0;
+  const timers = new Map();
+  return {
+    get now() {
+      return now;
+    },
+    setTimeout(fn, ms) {
+      seq += 1;
+      timers.set(seq, { fn, at: now + (ms || 0), id: seq });
+      return seq;
+    },
+    clearTimeout(id) {
+      timers.delete(id);
+    },
+    pending() {
+      return timers.size;
+    },
+    tick(ms) {
+      const target = now + ms;
+      for (;;) {
+        const due = [...timers.values()]
+          .filter((t) => t.at <= target)
+          .sort((a, b) => a.at - b.at)[0];
+        if (!due) break;
+        timers.delete(due.id);
+        now = due.at;
+        due.fn();
+      }
+      now = target;
+    },
+  };
+}
+
+/** 记录调用的假 fetch；`delay: true` 时返回受控 promise，测试手动 resolve。 */
+function makeFetch(plan = []) {
+  const calls = [];
+  let index = 0;
+  const impl = async (url, init = {}) => {
+    calls.push({ url, method: init.method ?? 'GET', body: init.body ? JSON.parse(init.body) : null });
+    const spec = plan[index] ?? { status: 200, body: { version: 1 } };
+    index += 1;
+
+    if (spec.throw) throw spec.throw;
+
+    const status = spec.status ?? 200;
+    const makeResponse = () => ({
+      ok: status >= 200 && status < 300,
+      status,
+      headers: new Headers(spec.headers ?? { 'content-type': 'application/json' }),
+      json: async () => spec.body ?? {},
+      text: async () => JSON.stringify(spec.body ?? {}),
+    });
+
+    if (spec.delay) {
+      return new Promise((resolve) => {
+        spec.resolve = () => resolve(makeResponse());
+      });
+    }
+    return makeResponse();
+  };
+  impl.calls = calls;
+  return impl;
+}
