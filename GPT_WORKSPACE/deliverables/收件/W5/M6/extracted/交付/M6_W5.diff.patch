+      timers.set(id, { fn, ms });
+      return id;
+    },
+    cancel(id) {
+      timers.delete(id);
+    },
+    fire(id) {
+      const entry = timers.get(id);
+      if (!entry) return false;
+      timers.delete(id);
+      entry.fn();
+      return true;
+    },
+    size() {
+      return timers.size;
+    },
+    ids() {
+      return [...timers.keys()];
+    },
+  };
