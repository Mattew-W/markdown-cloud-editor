# Gemini 3.8 Flash Markdown Studio 环境变量配置示例

# 数据库连接串 (支持 SQLite 嵌入式开箱即用，或 PostgreSQL 生产级连接)
# PostgreSQL 模式 (Project 10 课程验收模式):
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/mce_test

# SQLite 模式 (可选本地开发模式):
DATABASE_URL=sqlite://gemini_editor.db?mode=rwc

# JWT 鉴权秘钥 (必须配置且 >= 32 字节高熵串，严禁使用弱口令或公开默认值)
# 可通过运行 `openssl rand -base64 32` 或随机高熵字符串生成并配置于此：
JWT_SECRET=change_this_to_your_random_32_bytes_secret_key_entropy_here_123456

# JWT 令牌有效期 (秒)
JWT_TTL_SECS=3600

# HTTP 服务监听地址
BIND_ADDR=127.0.0.1:8080

# Google Gemini 官方 API Key (可选)
# 若留空，系统自动启用内置的高保真离线语义模拟引擎，100% 离线可用且全测试通过
# GEMINI_API_KEY=your_google_gemini_api_key_here

# Gemini 模型名称
GEMINI_MODEL=gemini-2.0-flash

# 日志级别
RUST_LOG=info
